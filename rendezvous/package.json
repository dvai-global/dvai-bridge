{
  "name": "dvai-bridge-rendezvous",
  "version": "0.1.0",
  "private": true,
  "description": "Self-hostable WebSocket relay for dvai-bridge's QR-pairing + cross-network device offload (v3.0). Stateless beyond per-session memory; no database; no auth.",
  "license": "MIT",
  "type": "module",
  "main": "dist/server.js",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "build": "tsc",
    "start": "node dist/server.js",
    "dev": "tsx watch src/server.ts",
    "test": "vitest run",
    "smoke": "bash scripts/smoke.sh",
    "lint": "eslint src tests"
  },
  "dependencies": {
    "fastify": "^5.12.8",
    "@fastify/websocket": "^11.3.7",
    "ws": "^8.23.0"
  },
  "devDependencies": {
    "@types/node": "^26.6.6",
    "@types/ws": "^8.18.2",
    "tsx": "^4.23.15",
    "typescript": "^6.0.3",
    "vitest": "^5.1.1"
  }
}
