{
  "name": "dvai-hub",
  "version": "4.3.0",
  "private": true,
  "description": "DVAI Hub — household-utility flavor of distributed inference. Run on a strong device; pair from any number of dvai-bridge mobile apps.",
  "license": "MIT",
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "build:peer-mode": "tsc -p peer-mode/tsconfig.json",
    "bundle:sidecar": "node scripts/bundle-sidecar.mjs",
    "smoke:ollama": "node dist/scripts/smoke-ollama.js",
    "smoke:lmstudio": "node dist/scripts/smoke-lmstudio.js",
    "smoke:identity": "node dist/scripts/smoke-identity.js",
    "sidecar:dev": "node dist/peer-mode/server.js",
    "build:vite": "vite build",
    "dev:vite": "vite",
    "test": "vitest run",
    "lint": "eslint peer-mode tests src",
    "dev:tauri": "tauri dev",
    "tauri:build": "tauri build"
  },
  "dependencies": {
    "@dvai-bridge/core": "workspace:*",
    "@noble/curves": "2.4.0",
    "@tailwindcss/vite": "^4.3.5",
    "@tauri-apps/api": "^2.12.5",
    "@tauri-apps/plugin-autostart": "^2.7.0",
    "@tauri-apps/plugin-notification": "^2.8.1",
    "lucide-react": "^1.77.0",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "tailwindcss": "^4.3.5"
  },
  "devDependencies": {
    "@tauri-apps/cli": "^2.12.6",
    "@types/node": "^26.6.6",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.3.0",
    "typescript": "^6.0.3",
    "vite": "^8.3.8",
    "vitest": "^5.1.1"
  }
}
