<Project>
  <!--
    Central Package Management (CPM). Every PackageReference across the solution
    inherits versions from this file — there are no <Version> attributes on
    PackageReference items in any csproj. Single source of truth.

    Pinned versions (latest stable at 2026-11-20, v4.3.0 dep sweep):
      - Microsoft.NET.Test.Sdk 18.12.0
      - xunit 2.9.3                    (latest v2; xunit.v3 migration tracked separately)
      - xunit.runner.visualstudio 4.0.1 (still runs xunit v2 tests)
      - Moq 4.21.0, coverlet.collector 10.1.1
      - Microsoft.SourceLink.GitHub 11.0.100 (10.0.300 pulled Microsoft.Build.Tasks.Git with NU1902)
  -->
  <PropertyGroup>
    <ManagePackageVersionsCentrally>true</ManagePackageVersionsCentrally>
  </PropertyGroup>
  <ItemGroup>
    <!-- Test stack -->
    <PackageVersion Include="Microsoft.NET.Test.Sdk" Version="18.12.0" />
    <PackageVersion Include="xunit" Version="2.9.3" />
    <PackageVersion Include="xunit.runner.visualstudio" Version="4.0.1" />
    <PackageVersion Include="Moq" Version="4.21.0" />
    <PackageVersion Include="coverlet.collector" Version="10.1.1" />
    <!-- Source link -->
    <PackageVersion Include="Microsoft.SourceLink.GitHub" Version="11.0.100" />

    <!-- ONNX Runtime + GenAI backend (Task 18-19, rev 2) -->
    <PackageVersion Include="Microsoft.ML.OnnxRuntime" Version="1.32.0" />
    <PackageVersion Include="Microsoft.ML.OnnxRuntimeGenAI" Version="0.20.0" />

    <!-- ML.NET backend (Task 21, rev 2) -->
    <PackageVersion Include="Microsoft.ML" Version="6.0.0" />
    <PackageVersion Include="Microsoft.ML.OnnxTransformer" Version="6.0.0" />
    <!-- Used by the MLNet path's hand-rolled tokenizer + sampler (Task 21) -->
    <PackageVersion Include="Microsoft.ML.Tokenizers" Version="3.0.0" />

    <!-- mDNS / DNS-SD for desktop LAN peer discovery (Task 8e — Phase 3 distributed inference) -->
    <PackageVersion Include="Makaretu.Dns.Multicast" Version="0.27.0" />
  </ItemGroup>
</Project>
